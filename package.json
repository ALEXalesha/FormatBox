{
  "name": "formatbox",
  "productName": "FormatBox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FormatBox: video, audio, images, documents, archives and 3D in one converter - in the browser or on the desktop, offline",
  "author": "ALEXalesha",
  "license": "MIT",
  "homepage": "https://alexalesha.github.io/FormatBox/",
  "main": "electron/main.js",
  "scripts": {
    "vendor": "node tools/vendor.js",
    "pretest": "node tools/vendor.js --quiet",
    "test": "node --test --test-concurrency=4 \"tests/core/*.test.js\"",
    "cover": "c8 node --test --test-concurrency=4 \"tests/core/*.test.js\"",
    "test:web": "playwright test --config=playwright.web.config.js",
    "test:app": "playwright test --config=playwright.app.config.js --workers=1",
    "mutate": "node tools/mutate.js",
    "serve": "node tools/serve.js",
    "start": "node tools/vendor.js --quiet && electron .",
    "screenshots": "node tools/screenshots.js"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.63.0",
    "7z-wasm": "^1.2.0",
    "c8": "^10.1.3",
    "earcut": "^3.0.1",
    "electron": "^43.0.0",
    "fast-check": "^4.3.0",
    "fflate": "^0.8.2",
    "heic2any": "^0.0.4",
    "jpeg-js": "^0.4.4",
    "mammoth": "^1.11.0",
    "manifold-3d": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149"
  }
}
